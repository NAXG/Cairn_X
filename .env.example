# Cairn_X 部署配置（docker compose 自动读取本文件；勿提交进 git）
# 使用方法：cp .env.example .env 后填值；以下两个凭据必填，否则 compose 拒绝启动。
# 分别运行 openssl rand -hex 32 生成两个独立随机值；不可使用旧默认 cairn-change-me。
# web 密码不会作为 Bearer token 的后备值。

# web 控制台登录密码（用户名 admin，可在 compose 里改 CAIRN_WEB_USER）
CAIRN_WEB_PASSWORD=

# 机器端 Bearer token（dispatcher / benchmark driver 访问控制面），与 web 密码不同
CAIRN_API_TOKEN=

# 模型 API key（dispatch.yaml 里以 env:DECIDE_API_KEY / env:EXECUTE_API_KEY 引用）
DECIDE_API_KEY=
EXECUTE_API_KEY=

# 宿主映射端口，默认 8000；与宿主已有服务冲突时改这里
# CAIRN_HTTP_PORT=8000

# Docker 宿主机上的共享数据目录（必须为绝对路径；包含数据库、轨迹和 uploads）
# CAIRN_DATA_HOST_ROOT=/opt/cairn/datas/cairn-x

# 日志级别：debug | info | warn | error；默认 info（Server / Dispatcher / Worker 共用）
# LOG_LEVEL=info

# TSecBench 评测接入（可选；不配则保持空）
# BENCHMARK_TOKEN=
# BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
